[connection]
id=enp2s0.3
type=vlan
interface-name=enp2s0.3

[ethernet]
cloned-mac-address=stable

[vlan]
flags=1
id=3
parent=enp2s0

[ipv4]
method=auto
never-default=true
dhcp-send-hostname=1
dhcp-hostname=nas-iot
ignore-auto-dns=true

[ipv6]
addr-gen-mode=default
method=auto
never-default=true
dhcp-send-hostname=1
dhcp-hostname=nas-iot
ignore-auto-dns=true
