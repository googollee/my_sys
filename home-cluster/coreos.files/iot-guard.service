[Unit]
Description=Restrict IoT VLAN access to host
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables/iot-guard.nft
ExecStop=/usr/sbin/nft delete table inet iot_guard

[Install]
WantedBy=multi-user.target
