{
  "ignition": {
    "version": "3.5.0"
  },
  "passwd": {
    "groups": [
      {
        "name": "www-data",
        "shouldExist": true,
        "system": true
      }
    ],
    "users": [
      {
        "name": "core",
        "shouldExist": false
      },
      {
        "groups": [
          "docker",
          "wheel",
          "sudo",
          "systemd-journal"
        ],
        "name": "googol",
        "sshAuthorizedKeys": [
          "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILRbXerF24s/H59FsEaPYfHZ1113Eij81+1ED7VGPK+p googol@mbp-laptop"
        ],
        "system": false
      },
      {
        "groups": [
          "www-data"
        ],
        "homeDir": "/nonexistent",
        "name": "www-data",
        "noCreateHome": true,
        "noUserGroup": true,
        "primaryGroup": "www-data",
        "shell": "/usr/sbin/nologin",
        "system": true
      }
    ]
  },
  "storage": {
    "files": [
      {
        "path": "/etc/hostname",
        "contents": {
          "compression": "",
          "source": "data:,nas"
        },
        "mode": 420
      },
      {
        "path": "/etc/zincati/config.d/55-updates-strategy.toml",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,H4sIAAAAAAAC/2TNMQrDMAyF4V2nED5AGtqtkKXQE3QMxphapILENrJMSE9fNGTqKj79b+41RaXmoalEpeXACV0l4ZL47QBOMJw3D8obhW/JZPTZpVS6PEhWzub/Hoadcyq795Di0XDCGd0rqkPbjKLBepa63sfRwUp50U/YOHcl47cRfgEAAP//3CdCIaYAAAA="
        },
        "mode": 420
      },
      {
        "path": "/etc/systemd/system/raid-check.timer.d/override.conf",
        "contents": {
          "compression": "",
          "source": "data:,%5BTimer%5D%0AOnCalendar%3D%0AOnCalendar%3DMon..Sun%20*-*-01%2002%3A45%3A00%20Europe%2FBerlin%0AAccuracySec%3D1min%0A"
        },
        "mode": 420
      },
      {
        "path": "/etc/systemd/system/k0scontroller.service.d/10-data.conf",
        "contents": {
          "compression": "",
          "source": "data:,%5BUnit%5D%0AAfter%3Dvar-mnt-data.mount%0AConditionPathIsMountPoint%3D%2Fvar%2Fmnt%2Fdata%0A"
        },
        "mode": 420
      },
      {
        "path": "/etc/NetworkManager/system-connections/enp2s0.3.nmconnection",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,H4sIAAAAAAAC/4TLQQrCMBBG4f3cJaJW3M1JShZD528NtJOQTgLeXooFl67f98Ypm2HylC1SUoaV+369DOTvAu6rGCVz1FkmBJMNP0HjkSPNqyw73457oCIV5iciGlPpj0gb/JWVpXkmQ0cNilna6uy14cuekUS1hgUWtqzgk/ybPwEAAP//yK6a/sIAAAA="
        },
        "mode": 384
      },
      {
        "path": "/etc/nftables/iot-guard.nft",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 420
      },
      {
        "path": "/etc/k0s/config.yaml",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 420
      },
      {
        "path": "/home/googol/install_k0s.sh",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,H4sIAAAAAAAC/xzNPU7FMAwA4D2nMI/hTc5PBwRIPQUnSIObRDFJFbsIJA6PXtdv+Z6f3Fa7k2JMOicD4jGHDrivRfWQOyAqy3ewC6B87HDpu3OZ1DYvVgr8gRTTvEDtopEZ0ug6BzNNQJTaMxNgAkeaXPPi0uh7zfY3fj2+dm7EpEg/OiPGmWW9IfbxSViPNbwtNry82uDtcrsW0TjV/AcAAP//b1uckrgAAAA="
