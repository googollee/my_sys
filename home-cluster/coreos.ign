{
  "ignition": {
    "version": "3.5.0"
  },
  "passwd": {
    "groups": [
      {
        "name": "www-data",
        "shouldExist": true,
        "system": true
      }
    ],
    "users": [
      {
        "groups": [
          "docker",
          "wheel",
          "sudo",
          "systemd-journal"
        ],
        "name": "googol",
        "sshAuthorizedKeys": [
          "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILRbXerF24s/H59FsEaPYfHZ1113Eij81+1ED7VGPK+p googol@mbp-laptop"
        ],
        "system": false
      },
      {
        "groups": [
          "www-data"
        ],
        "homeDir": "/nonexistent",
        "name": "www-data",
        "noCreateHome": true,
        "noUserGroup": true,
        "primaryGroup": "www-data",
        "shell": "/usr/sbin/nologin",
        "system": true
      }
    ]
  },
  "storage": {
