        "mode": 493
      }
    ],
    "links": [
      {
        "path": "/etc/localtime",
        "target": "../usr/share/zoneinfo/Europe/Berlin"
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "contents": "[Unit]\nDescription=Enable CPU power saving\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/bin/sh -c '/usr/bin/echo \"power\"     | tee /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference'\nExecStart=/usr/bin/sh -c '/usr/bin/echo \"powersave\" | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor'\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "cpu-governor.service"
      },
      {
        "contents": "[Unit]\nRequires=systemd-fsck@dev-md-data.service\nAfter=systemd-fsck@dev-md-data.service\n\n[Mount]\nWhere=/var/mnt/data\nWhat=/dev/md/data\nType=none\n\n[Install]\nRequiredBy=local-fs.target\n",
        "enabled": false,
        "name": "var-mnt-data.mount"
      },
      {
        "contents": "[Unit]\nDescription=Restrict IoT VLAN access to host\nWants=network-pre.target\nBefore=network-pre.target shutdown.target\nConflicts=shutdown.target\nDefaultDependencies=no\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/sbin/nft -f /etc/nftables/iot-guard.nft\nExecStop=/usr/sbin/nft delete table inet iot_guard\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "iot-guard.service"
      }
    ]
  }
}
